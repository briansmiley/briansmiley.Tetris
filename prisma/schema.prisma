generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model HighScore {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  score         Int
  initials      String
  gameStartTime String
  linesCleared  Int
  platform      PLATFORM
  gameMode      GAME_MODE @default(BASIC)
}

enum PLATFORM {
  MOBILE
  DESKTOP
}

enum GAME_MODE {
  BASIC
  ADVANCED
}
